<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="pox"
          fetch="https://github.com/pox-os"
          sync-c="true"
          sync-j="4"
          revision="refs/heads/pox-15.0" />

  <!-- POX OS Overrides: Replace standard Google AOSP components with customized repositories -->
  <remove-project name="platform/frameworks/base" />
  <project path="frameworks/base" name="frameworks_base" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="pox" />

  <remove-project name="platform/packages/apps/Settings" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" groups="pdk-fs" remote="pox" />

  <remove-project name="platform/build" />
  <project path="build/make" name="build_make" groups="pdk,sysui-studio" remote="pox">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <!-- POX OS Custom Components -->
  <project path="manifest" name="manifest" remote="pox" />
  <project path="vendor/pox" name="vendor_pox" remote="pox" />
  <project path="packages/apps/PoxHub" name="packages_apps_PoxHub" remote="pox" />
</manifest>
